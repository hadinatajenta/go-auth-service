# Auth-Service Configuration
# Copy this file to .env and update with your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_service_user
DB_PASSWORD=change_this_strong_password
DB_NAME=auth_service

# SSL Mode: disable (development), require (production)
# CRITICAL: Use 'require' in production!
DB_SSLMODE=require

# ============================================================================
# JWT SECURITY
# ============================================================================
# CRITICAL: JWT_SECRET must be at least 32 characters and cryptographically random
# Generate with: openssl rand -base64 32
# DO NOT use the same secret across different environments
JWT_SECRET=change_this_to_32_character_random_secret_key

# ============================================================================
# APPLICATION
# ============================================================================
APP_PORT=8080

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://app.example.com
# CRITICAL: Do NOT use wildcard (*) in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# ============================================================================
# PASSWORD POLICY (Optional)
# ============================================================================
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=false

# ============================================================================
# RATE LIMITING (Optional)
# ============================================================================
# Requests per minute on auth endpoints
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=10

# ============================================================================
# ACCOUNT LOCKOUT (Optional)
# ============================================================================
FAILED_LOGIN_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# ============================================================================
# LOGGING (Optional)
# ============================================================================
# Options: debug, info, warn, error
APP_LOG_LEVEL=info

# ============================================================================
# AUDIT (Optional)
# ============================================================================
AUDIT_LOG_ENABLED=true

# ============================================================================
# SECURITY FLAGS (Optional)
# ============================================================================
# Disable RBAC debug endpoints in production
ENABLE_RBAC_DEBUG=false

# ============================================================================
# NOTES
# ============================================================================
# 1. All passwords and secrets must be strong and unique
# 2. Use a secrets manager in production (AWS Secrets Manager, Vault, etc.)
# 3. Rotate JWT_SECRET annually with grace period
# 4. Never commit this file with actual secrets to version control
# 5. Database backups should be automated and tested regularly
